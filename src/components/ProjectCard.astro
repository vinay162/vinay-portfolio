---
import type { CardLink, Figure } from '../data/site';

interface Props {
  title: string;
  summary: string;
  stack: string;
  note?: string;
  /** Still being worked on. */
  ongoing?: boolean;
  /** Link to the project's own page, when it has one. */
  href?: string;
  links: CardLink[];
  figures: Figure[];
}

const { title, summary, stack, note, ongoing, href, links, figures } = Astro.props;
const hasLinks = Boolean(href) || links.length > 0;
---
<article class:list={["project", { ongoing }]}>
  <div>
    <h3>
      {href ? <a class="title-link" href={href}>{title}</a> : title}
      {ongoing && <span class="pill">Ongoing</span>}
    </h3>
    <p>{summary}</p>
    <p class="stack">{stack}{note && ` ${note}`}</p>
    {hasLinks && (
      <p class="links">
        {href && <a class="more" href={href}>View project<span class="sr-only">: {title}</span></a>}
        {links.map((link) => <a href={link.url} target="_blank" rel="noopener">{link.label}</a>)}
      </p>
    )}
  </div>
  <div class:list={["figures", { single: figures.length === 1 }]}>
    {figures.map((figure) => (
      <div>
        <span class="value">{figure.value}</span>
        <span class="label">{figure.label}</span>
      </div>
    ))}
  </div>
</article>

<style>
  .project {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 24px 48px;
    align-items: start;
    padding: 32px;
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-radius: 10px;
  }
  .project.ongoing { border: 1.5px solid var(--accent); }

  /* The whole card opens the project page. Only the title is a real link
     (screen readers hear just the name); its ::after stretches over the
     card. Other links sit above that layer so they still work on their own. */
  .project { position: relative; }
  .title-link { color: inherit; text-decoration: none; }
  .title-link::after { content: ''; position: absolute; inset: 0; border-radius: 10px; }
  .title-link:focus-visible { outline: none; }
  .title-link:focus-visible::after { outline: 3px solid var(--accent); outline-offset: 3px; }
  .links a { position: relative; z-index: 1; }
  .project:has(.title-link:hover) { border-color: var(--accent); }
  .title-link:hover, .title-link:focus-visible {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
  .pill {
    display: inline-block;
    margin-left: 12px;
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--tint);
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0;
    vertical-align: 0.3em;
  }
  h3 { margin: 0 0 10px; font-size: 1.625rem; font-weight: 650; line-height: 1.2; letter-spacing: -0.015em; }
  p { margin: 0; max-width: 54ch; }
  .stack { margin-top: 12px; color: var(--muted); font-size: 0.9375rem; }
  .links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 18px; }
  .links a { color: var(--muted); }
  .links a:hover { color: var(--accent); }
  .links .more { color: var(--accent); font-weight: 600; }

  .figures {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 28px;
    padding: 22px 24px;
    background: var(--tint);
    border-radius: 8px;
  }
  .figures.single { grid-template-columns: 1fr; }
  .value {
    display: block;
    font-size: 2rem;
    font-weight: 650;
    font-stretch: 80%;
    line-height: 1.05;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .label { display: block; margin-top: 6px; color: var(--muted); font-size: 0.9375rem; line-height: 1.4; }

  @media (max-width: 800px) {
    .project { grid-template-columns: 1fr; padding: 22px 20px; }
    .figures { padding: 18px 20px; }
    .value { font-size: 1.625rem; }
  }
</style>
