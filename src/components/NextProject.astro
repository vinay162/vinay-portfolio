---
// The navy band that closes a project page: where to go next, and the
// project's main outside link.

interface Props {
  /** The next project by order, or nothing when this is the only one. */
  next?: { title: string; href: string };
  outside?: { label: string; url: string };
}

import { site } from '../data/site';

const { next, outside } = Astro.props;
---
<nav class="band-ink next" aria-label="More projects">
  <div class="wrap">
    <div>
      <span>{next ? 'Go to the next project' : 'See more'}</span>
      <a class="heading onward" href={next ? next.href : '/#projects'}>{next ? next.title : 'All projects'}</a>
    </div>
    {outside && (
      <div>
        <span>Open this project on</span>
        <a class="heading" href={outside.url} target="_blank" rel="noopener">{outside.label}</a>
      </div>
    )}
  </div>
</nav>
<!-- Someone who reads a whole project page should be able to get in touch without going back. -->
<footer class="band-ink reach">
  <div class="wrap">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <a href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    <a href={site.links.github} target="_blank" rel="noopener">GitHub</a>
    <a href={site.resumePath} target="_blank" rel="noopener">Resume (PDF)</a>
  </div>
</footer>

<style>
  .next { padding: 44px 0 56px; }
  .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px; }
  span { display: block; color: var(--on-ink-muted); font-size: 0.9375rem; }
  a { font-size: 1.5rem; }
  a:hover { color: var(--on-ink-hover); }
  .onward { text-decoration-color: var(--pop); text-decoration-thickness: 3px; text-underline-offset: 0.16em; }

  .reach { padding: 0 0 36px; }
  .reach .wrap {
    justify-content: flex-start;
    gap: 10px 28px;
    padding-top: 24px;
    border-top: 1px solid var(--ink-rule);
  }
  .reach a { font-size: 0.9375rem; color: var(--on-ink-muted); overflow-wrap: anywhere; }
  .reach a:hover { color: var(--on-ink); }
</style>
