---
// A "how it works" diagram: steps joined by lines. Built in HTML so it stays
// sharp, readable by screen readers, and stacks vertically on narrow screens.

interface Step {
  label: string;
  sub?: string;
  /** Built by Vinay: drawn in the accent colour. */
  mine?: boolean;
}

type Item = Step | { pair: Step[] };

interface Props {
  steps: Item[];
  caption: string;
}

const { steps, caption } = Astro.props;
---
<figure class="diagram">
  <ol class="flow">
    {steps.map((item) => (
      <li>
        {'pair' in item ? (
          <span class="pair">
            {item.pair.map((step) => (
              <span class:list={['flow-step', { mine: step.mine }]}>
                {step.label}
                {step.sub && <small>{step.sub}</small>}
              </span>
            ))}
          </span>
        ) : (
          <span class:list={['flow-step', { mine: item.mine }]}>
            {item.label}
            {item.sub && <small>{item.sub}</small>}
          </span>
        )}
      </li>
    ))}
  </ol>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .diagram {
    margin: 0;
    padding: 28px;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 10px;
  }
  .flow { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 0; margin: 0; padding: 0; list-style: none; }
  li { display: flex; align-items: center; }
  li + li::before { content: ""; flex: none; width: 22px; border-top: 1.5px solid var(--ink); }

  .flow-step {
    display: block;
    padding: 9px 13px;
    background: var(--sheet);
    border: 1.5px solid var(--ink);
    border-radius: 5px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .flow-step small { display: block; color: var(--muted); font-size: 0.8125rem; font-weight: 400; }
  .flow-step.mine { background: var(--tint); border-color: var(--accent); color: var(--accent); }
  .flow-step.mine small { color: var(--accent); }
  .pair { display: grid; gap: 8px; }

  figcaption { margin-top: 20px; color: var(--muted); font-size: 0.9375rem; }

  /* Stack the steps when they no longer fit on one line */
  @media (max-width: 1020px) {
    .flow { flex-direction: column; align-items: flex-start; gap: 0; }
    li { flex-direction: column; align-items: flex-start; }
    li + li::before { width: 0; height: 14px; margin-left: 20px; border-top: 0; border-left: 1.5px solid var(--ink); }
  }
  @media (max-width: 800px) {
    .diagram { padding: 18px; }
  }
</style>
