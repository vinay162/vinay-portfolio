---
import { site } from '../data/site';
---
<section class="band-ink section contact" id="contact">
  <div class="wrap">
    <h2 class="section-title heading">Contact</h2>
    <a class="mail heading" href={`mailto:${site.email}`}>{site.email}</a>
    <ul>
      <li><a href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a href={site.links.github} target="_blank" rel="noopener">GitHub</a></li>
      <li><a href={site.resumePath} target="_blank" rel="noopener">Resume (PDF)</a></li>
    </ul>
  </div>
</section>

<style>
  .mail {
    font-size: clamp(1.5rem, 4.4vw, 2.75rem);
    text-decoration-color: var(--pop);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.16em;
    overflow-wrap: anywhere;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
    color: var(--on-ink-muted);
  }
  a:hover { color: var(--on-ink-hover); }
</style>
